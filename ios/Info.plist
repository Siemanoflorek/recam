<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>RealCam</string>
    <key>CFBundleDisplayName</key>
    <string>RealCam</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIStatusBarHidden</key>
    <false/>

    <!-- Powody dostępu do sprzętu -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Aplikacja używa mikrofonu do przesyłania dźwięku na Twój komputer.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Aplikacja łączy się z serwerem na Twoim komputerze w sieci lokalnej.</string>

    <!-- Praca w tle (audio podtrzymuje sesję; kamera i tak tylko na wierzchu) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Pozwól na połączenie ws:// (bez TLS) w sieci lokalnej -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
